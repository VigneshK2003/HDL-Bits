module top_module (
    input clk,
    input areset,
    input x,
    output reg z
); 
    parameter [1:0]A = 2'b0, B = 2'd1, C = 2'd2;
    reg  [1:0]state, next_state;
    
    always@(posedge clk , posedge areset)
      begin
        if( areset)
            state <= A;
        else
            state <= next_state;
       end 
    
    always@(*)
       begin
           next_state = state;
           case(state)
               A : next_state = (x)? B : A; 
               B : next_state = (x)? C : B;
               C : next_state = (x)? C : B;
    			default : next_state = A;
           endcase
       end

    assign z = (state == B);
endmodule 
